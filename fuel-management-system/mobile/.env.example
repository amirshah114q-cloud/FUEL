# ---------------------------------------------------------------------------
# Fleet Fuel Manager — mobile environment
# Copy to .env and adjust. Restart `npx expo start` after changing it.
# EXPO_PUBLIC_ variables are embedded into the JS bundle at start time.
# ---------------------------------------------------------------------------

# Backend API base URL:
#  - Android Emulator (backend runs on your computer): http://10.0.2.2:5000
#  - Physical phone on the same Wi-Fi:                    http://<YOUR-LAN-IP>:5000
#    (find your IP with `ipconfig` on Windows / `ifconfig` or `ip a` on macOS/Linux)
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000