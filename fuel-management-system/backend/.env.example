# ---------------------------------------------------------------------------
# Fuel Expense & Slip Management System — Backend environment
# Copy this file to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000

# Database (local MongoDB or MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/fuel_management

# Authentication
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_16_CHARS
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# CORS — comma-separated origins (e.g. http://localhost:19006,http://localhost:3000) or * for all
CORS_ORIGIN=*

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Public base URL used when building absolute slip-file URLs returned to the
# mobile app (leave empty to use the incoming request host).
# Example for physical-device testing on the same Wi-Fi: http://192.168.1.10:5000
PUBLIC_BASE_URL=

# OCR provider (Phase 2): "tesseract" (local, no key needed) or "google-vision"
OCR_PROVIDER=tesseract
GOOGLE_VISION_API_KEY=